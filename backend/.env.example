# Local development only. Copy to .env and enter your own credentials.
# These variables are placeholders; your Python implementation must load them.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=todo_manager
DB_USER=todo_user
DB_PASSWORD=replace_with_your_local_password
FRONTEND_ORIGIN=http://localhost:5500

# Local HTTP development: false. Set true when deploying behind HTTPS.
COOKIE_SECURE=false
# local writes private .eml previews to backend/reset-emails/ (never served).
# Set smtp to send real email using STARTTLS on port 587.
RESET_DELIVERY=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=taskwell@localhost
